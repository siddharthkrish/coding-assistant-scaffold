{
  "name": "pair-programming-orchestrator",
  "version": "0.1.3",
  "type": "module",
  "description": "A durable Claude Code + Codex review/fix/merge orchestrator",
  "license": "MIT",
  "bin": {
    "agent-orchestrator": "dist/cli.js"
  },
  "files": [
    "dist/",
    "schemas/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "codex",
    "claude-code",
    "agents",
    "orchestrator",
    "code-review"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "doctor": "node src/cli.ts doctor",
    "test": "node --test test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "check": "npm test && npm run build",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run --json"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  }
}
